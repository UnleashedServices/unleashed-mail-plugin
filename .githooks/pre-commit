#!/bin/bash
# Git pre-commit hook — runs linting, build, tests, PII checks, and the diff-scoped trunk gate.
# Install: git config core.hooksPath .githooks

overall=0

# CLEANUP ON ANY EXIT, INCLUDING AN INTERRUPTED COMMIT. `run_with_timeout` creates a private
# directory for its deadline marker and removes it on the normal path — but a Ctrl-C inside the
# 180s window kills the hook outright, and the directory survives: one per interrupted commit,
# accumulating in TMPDIR forever. Measured with a process-group SIGINT, SIGHUP and SIGKILL; the
# straight-line `rm -rf` reached none of them.
#
# THE TRAP LIVES AT SCRIPT SCOPE, NOT INSIDE THE FUNCTION. A trap set in a function fires at
# FUNCTION RETURN under zsh and at PROCESS EXIT under bash, and a script owns exactly one EXIT
# slot — so the function publishes the path and the script owns the disposal. SIGKILL cannot be
# trapped and is not claimed to be: this narrows the leak to the one signal nothing can catch.
# THE PROCESS GROUPS THIS RUN OWNS. `set -m` gives the bounded command and the watchdog their own
# groups precisely so they can be signalled as a unit — which also means a signal aimed at THIS
# script never reaches them. Removing the marker directory and exiting therefore looked orderly
# while leaving `trunk` and a `sleep` running out the rest of the deadline: measured, three live
# processes after the hook had exited (codex, PR #85). The handler tears down what it started.
RWT_TMPDIR=""
RWT_ACTIVE_PIDS=""
# shellcheck disable=SC2329  # invoked only from the trap handlers below, which shellcheck
# cannot see through: the name is a word in a trap string, not a call site. Verified by
# measurement rather than by asserting it — a mid-run SIGINT, SIGTERM and SIGHUP each leave
# no `rwt.*` behind, which is only true if this runs.
_rwt_cleanup() {
	local _pid
	for _pid in ${RWT_ACTIVE_PIDS}; do
		# THE GROUP, THEN THE PID — the same pairing every other signal site in this file uses,
		# because `set -m` can fail and then `kill -- -PID` fails with ESRCH and kills NOTHING.
		kill -KILL "-${_pid}" 2>/dev/null || kill -KILL "${_pid}" 2>/dev/null
	done
	RWT_ACTIVE_PIDS=""
	if [[ -n ${RWT_TMPDIR} ]]; then
		rm -rf "${RWT_TMPDIR}"
		RWT_TMPDIR=""
	fi
	return 0
}
trap _rwt_cleanup EXIT
trap '_rwt_cleanup; exit 130' INT
trap '_rwt_cleanup; exit 143' TERM
trap '_rwt_cleanup; exit 129' HUP

# RESOLVE OR REFUSE. `$(cd … && pwd)` yields an EMPTY string when the cd fails, which made
# SCRIPT_DIR "/scripts", the helper test below fail, and the hook `exit 0` — reporting a clean
# commit having run nothing at all. A hook that cannot locate itself has checked nothing, and
# must not say otherwise (COREDEV-2807).
if ! _hook_root="$(cd "$(dirname "$0")/.." && pwd)" || [[ -z ${_hook_root} ]]; then
	echo "❌ pre-commit: could not resolve the repository root from '$0' — NO check ran" >&2
	exit 1
fi
SCRIPT_DIR="${_hook_root}/scripts"

if [[ -f "$SCRIPT_DIR/pre-commit-checks.sh" ]]; then
	bash "$SCRIPT_DIR/pre-commit-checks.sh" || overall=$?
else
	# NOT `exit 0`. This branch used to END THE HOOK, so a helper that was renamed, deleted or
	# simply absent on an older branch silently disabled every LATER gate as well — including
	# the trunk check this ticket exists to run, and the drift detector at the end. A missing
	# helper disables the helper, and nothing else (COREDEV-2807).
	echo "⚠️  pre-commit-checks.sh not found at $SCRIPT_DIR — skipping it; later gates still run"
fi

# COREDEV-2780 M5a — the local half of the trunk gate (§6.3 decided: WIRE IT, blocking).
#
# `--index`, NOT the worktree: the commit is made from the INDEX, so checking anything else lets a
# finding that is clean in the worktree and dirty in the index sail through — and reports findings for
# work that is not being committed.
# `--no-fix`: this Trunk version applies fixes automatically otherwise, and a hook that rewrites files
# under you during a commit is worse than one that refuses.
# §6.4's declared exclusion: markdown-link-check is a network round trip per commit, failing on someone
# else's outage — the same "red by default" trap §1 rejects for CI.
# NEVER `--all`: the 9027-issue backlog would block every commit.
TRUNK_TIMEOUT_SECONDS=180 # M5a: measured 30.8s cold-bootstrap envelope x ~6 headroom.
# docs/planning/evidence/COREDEV-2780-m5a-timeout-measurement.json

# MACOS-PORTABLE. Stock macOS ships NEITHER `timeout` NOR `gtimeout` — they arrive only with homebrew
# coreutils, so a hook that assumes them is broken on a clean Mac, which is most of the machines this
# runs on. Prefer them when present, and otherwise use a watchdog built from what every shell has.
run_with_timeout() {
	local seconds="$1"
	shift

	# ONE SHAPE FOR ALL THREE BRANCHES. Previously the coreutils branches returned early, so the
	# escalation, the process-group teardown and the timeout bookkeeping existed ONLY in the
	# hand-rolled fallback — the branch that runs when neither tool is installed, which is neither
	# this repo's CI (ubuntu-latest) nor any Mac with homebrew coreutils. The guarantees were proven
	# for the branch that does not run (codex, PR #84). Everything below is now branch-independent;
	# only the bounding MECHANISM differs.
	local _rwt_bounded
	_rwt_bounded="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"

	local _rwt_marker="" _rwt_dir _rwt_tmpdir="" _rwt_try
	# THE CHANNEL IS LOAD-BEARING ON BOTH BRANCHES NOW, so it is probed BY WRITING rather than
	# assumed. `${TMPDIR:-/tmp}` fails SILENTLY when TMPDIR names a directory that is missing or
	# unwritable: the write happens in a subshell whose stderr goes to /dev/null, the marker never
	# appears, and a genuine timeout is then classified as an external signal — the gate blocks with
	# a diagnostic naming the wrong cause (COREDEV-2806). `-w` is NOT sufficient: a full filesystem,
	# a read-only mount and a restrictive ACL each pass it and then fail the open.
	# `mkdir`, NOT A BARE REDIRECT INTO A PREDICTABLE NAME. The probe used to open
	# `${TMPDIR:-/tmp}/rwt.$$.${RANDOM}.deadline`, and with TMPDIR unset that is world-writable
	# `/tmp`. `$$` is observable and RANDOM is 15 bits, so another local process can pre-create
	# that exact name AS A SYMLINK; the redirection then follows it and TRUNCATES whatever the
	# committing user can write. Demonstrated on this machine before the change (codex, PR #85).
	# `mkdir` is ATOMIC and refuses a path that already exists in ANY form — file, directory or
	# symlink — so a pre-planted name makes it fail rather than follow, and we simply try another.
	# Everything the deadline needs then lives inside a directory that did not exist a moment ago
	# and is ours at 0700. It also subsumes the writability probe: `-w` was never sufficient, since
	# a full filesystem, a read-only mount and a restrictive ACL all pass it and then fail the open.
	#
	# `mkdir`, NOT `mktemp -d`, and the difference is not style. `mktemp` is an EXTERNAL binary
	# this hook did not previously need; where it is absent every candidate fails, the channel
	# dies, and a genuine timeout reports as a signal — COREDEV-2806 returning through its own
	# repair. Measured: the sanitised harness has no `mktemp`, and the 2806 regression test went
	# red with rc=143 exactly as it did before that ticket was fixed.
	for _rwt_dir in "${TMPDIR:-}" /tmp "$(git rev-parse --git-dir 2>/dev/null || true)" "${HOME-}" .; do
		[[ -n ${_rwt_dir} && -d ${_rwt_dir} ]] || continue
		for _rwt_try in 1 2 3 4 5; do
			_rwt_tmpdir="${_rwt_dir%/}/rwt.$$.${RANDOM}.d"
			if mkdir -m 700 "${_rwt_tmpdir}" 2>/dev/null; then
				_rwt_marker="${_rwt_tmpdir}/deadline"
				# CREATING THE DIRECTORY IS NOT EVIDENCE THAT THE MARKER CAN BE WRITTEN. An inode or
				# quota limit reached after `mkdir` leaves the later `: >"${_rwt_marker}"` failing
				# silently in the watchdog, which still kills trunk — and both RWT_TIMED_OUT and
				# RWT_NO_CHANNEL then read false, so the caller blames an external signal and blocks
				# the commit naming a cause it has no evidence for (codex, PR #85). Probe the actual
				# FILE, not just its parent, and treat a directory we cannot write in as no channel.
				if : 2>/dev/null >"${_rwt_marker}"; then
					rm -f "${_rwt_marker}"
				else
					rm -rf "${_rwt_tmpdir}"
					_rwt_tmpdir=""
					_rwt_marker=""
					continue
				fi
				# PUBLISHED for the script-scope trap, which is the only thing that runs when the
				# commit is interrupted before the teardown below is reached.
				RWT_TMPDIR="${_rwt_tmpdir}"
				break 2
			fi
		done
		_rwt_tmpdir=""
	done
	# PUBLISHED like RWT_TIMED_OUT, because the caller cannot infer this either: with no channel the
	# deadline still KILLS, it simply cannot be RECORDED, and every timeout then looks like a signal.
	if [[ -n ${_rwt_marker} ]]; then
		RWT_NO_CHANNEL=0
	else
		RWT_NO_CHANNEL=1
	fi

	# JOB CONTROL, so the child leads its OWN process group and can be signalled as `-PGID`. Without
	# it only the direct child is reached: a lint tool spawns helpers that INHERIT THE CALLER'S PIPE,
	# so anything capturing this hook stays blocked after the hook itself has returned.
	local _rwt_job_control=1
	set -m 2>/dev/null || _rwt_job_control=0

	local _rwt_cmd _rwt_watchdog="" _rwt_rc _rwt_timed_out=0
	# DELIBERATELY NOT `local`. The caller has to distinguish "we stopped it" from "it exited with a
	# status that happens to look like ours", and no exit status can carry that: 124, 137 and 143 are
	# each producible BY THE CHILD. Three separate fail-opens came from inferring the fact from the
	# code. The fact is published here instead, and the caller reads the fact.
	RWT_TIMED_OUT=0
	# ONE MECHANISM, ONE FACT, ON BOTH BRANCHES. The deadline is owned by a watchdog that RECORDS it
	# before it acts, because that is the only ordering in which the record cannot lose a race with
	# the kill. `timeout`, where present, is kept as a BACKSTOP ten seconds later: it bounds the case
	# where the watchdog subshell itself dies, and it never owns the deadline, so its status is never
	# the thing that has to be interpreted.
	#
	# IT USED TO OWN IT, and it cannot say whether it fired — 124, 137 and 143 are each producible BY
	# THE CHILD. The guard that resolved them compared `${SECONDS}`, an INTEGER clock sampled before
	# the fork, so the elapsed it computed read up to a second HIGH and laundered a command's own exit
	# 124 into "we timed out". That is a fail-OPEN — a timeout deliberately does not block the commit
	# — and the fourth member of the very family the guard was written to close (COREDEV-2805).
	if [[ -n ${_rwt_bounded} ]]; then
		# `-k 5`, NOT `--kill-after=5`. Measured across implementations: the short form is accepted by
		# GNU, FreeBSD, busybox and toybox, while the long form is rejected by busybox (exit 1) and
		# toybox (exit 125) — and a rejected flag would fail EVERY commit for those users, trading a
		# rare hang for universal breakage.
		"${_rwt_bounded}" -k 5 "$((seconds + 10))" "$@" &
		_rwt_cmd=$!
	else
		"$@" &
		_rwt_cmd=$!
	fi
	# TERM, A GRACE PERIOD, THEN KILL, with the deadline RECORDED before any signal. The watchdog's
	# fds are redirected because a background subshell inherits this hook's stdout and would hold a
	# capturing parent open for the whole timeout even after the hook exited.
	(
		sleep "${seconds}"
		# GUARDED: with no writable directory anywhere, `_rwt_marker` is empty and `: >""` is an
		# ambiguous redirect. The subshell suppresses it, but a suppressed error is still an error
		# in the one path where the channel is already known to be broken (gemini, PR #85).
		[[ -n ${_rwt_marker} ]] && : >"${_rwt_marker}"
		kill -TERM "-${_rwt_cmd}" 2>/dev/null || kill -TERM "${_rwt_cmd}" 2>/dev/null
		sleep 5
		kill -KILL "-${_rwt_cmd}" 2>/dev/null || kill -KILL "${_rwt_cmd}" 2>/dev/null
	) >/dev/null 2>&1 &
	_rwt_watchdog=$!
	# PUBLISHED for the interrupt handler — the only thing that runs if the commit is killed
	# before `wait` returns.
	RWT_ACTIVE_PIDS="${_rwt_cmd} ${_rwt_watchdog}"
	[[ ${_rwt_job_control} -eq 1 ]] && set +m

	wait "${_rwt_cmd}" 2>/dev/null
	_rwt_rc=$?

	if [[ -n ${_rwt_watchdog} ]]; then
		# THE GROUP, because the watchdog is a subshell BLOCKED IN `sleep`. Signalling the subshell
		# alone leaves that `sleep` orphaned to PPID 1, where it runs out the full deadline — so
		# every fast commit on a stock Mac left a `sleep 180` behind, and they accumulate (codex,
		# PR #84). The watchdog is started while job control is on, so it leads its own group; the
		# bare-pid retry is the same fallback the signals above use for a shell that granted none.
		kill -TERM "-${_rwt_watchdog}" 2>/dev/null || kill -TERM "${_rwt_watchdog}" 2>/dev/null
		wait "${_rwt_watchdog}" 2>/dev/null
		[[ -e ${_rwt_marker} ]] && _rwt_timed_out=1
		# INLINE, NOT A CALL OUT TO THE SCRIPT-SCOPE HELPER. This function is sliced out of the
		# file and sourced on its own by the suite, so a body that depends on a definition
		# outside it silently stops disposing of anything there — which is exactly what happened
		# when this was a bare `_rwt_cleanup` call: ten tests went red with real directories left
		# on disk. The trap at script scope is the NET for an interrupted commit, not the
		# primary path, and both act on the same variable so they cannot disagree.
		if [[ -n ${_rwt_tmpdir} ]]; then
			rm -rf "${_rwt_tmpdir}"
		fi
		RWT_TMPDIR=""
		RWT_ACTIVE_PIDS=""
	fi

	RWT_TIMED_OUT=${_rwt_timed_out}
	if [[ ${_rwt_timed_out} -eq 1 ]]; then
		# THE PENDING ESCALATION DIED WITH THE WATCHDOG, so do it here. `wait` returns as soon as the
		# DIRECT child does, and killing the watchdog then cancels its `sleep 5; kill -KILL` — so a
		# grandchild that ignores TERM outlives the deadline and keeps holding the caller's stdout.
		# Measured at 45s against a 2s deadline before this line existed, on BOTH branches.
		# THE PID FALLBACK IS NOT DECORATION. `set -m` can fail, and then the child is never a group
		# leader, so `kill -- -PID` fails with ESRCH and kills NOTHING — measured. Lines above pair
		# every group signal with a pid retry; this one did not, which left the teardown silently
		# inert on exactly the shells that could not give the child its own group (gemini, PR #84).
		kill -KILL "-${_rwt_cmd}" 2>/dev/null || kill -KILL "${_rwt_cmd}" 2>/dev/null
		# ONE STATUS FOR ONE FACT: every branch reports a timeout as 124, so the caller classifies a
		# recorded fact rather than a per-branch exit code.
		return 124
	fi
	return "${_rwt_rc}"
}

if ! command -v trunk >/dev/null 2>&1; then
	# ADVISORY, NOT BLOCKING: contributors without trunk installed must still be able to commit,
	# and CI's required context is the enforcing copy. But SILENCE was wrong — this printed
	# nothing at all, so "no output" was indistinguishable from "checked, and clean".
	echo "ℹ️  trunk is not installed — the staged-diff lint gate did NOT run (CI still enforces it)"
elif [[ ! -f .trunk/trunk.yaml ]]; then
	# MEASURED in a checkout with no `.trunk/`: the exact invocation below exits 1 with "Please
	# run 'trunk init' to setup trunk in this repository." Exit 1 is this gate's "new findings
	# in the staged diff" — a false statement about the developer's diff that no amount of
	# fixing the diff can clear. Branches predating the config reach this by being checked out
	# and committed to, which is why the guard is a PRECONDITION and not a status arm.
	echo "ℹ️  no .trunk/trunk.yaml in this checkout — the staged-diff lint gate did NOT run"
else
	echo "🧹 trunk check (staged diff only)…"
	if run_with_timeout "${TRUNK_TIMEOUT_SECONDS}" \
		trunk check --index --no-fix --filter=-markdown-link-check; then
		echo "✅ trunk: no new findings in the staged diff"
	else
		_trunk_rc=$?
		if [[ ${RWT_TIMED_OUT:-0} -eq 1 ]]; then
			# A timeout is an INFRASTRUCTURE failure, not a lint finding. Blocking the commit on
			# someone's slow network would teach people to pass --no-verify, which disables every
			# check above as well.
			#
			# THE FACT, NOT A STATUS. This arm keyed on 124, then on `124 || 143`, and each time a
			# reviewer found another status the CHILD can produce that is indistinguishable from the
			# wrapper's own: 143 from an external kill, 137 from the OOM killer, and 124 from `trunk`
			# propagating an internal tool timeout. Every one of those reported "exceeded 180s" and
			# let the commit through after an incomplete lint.
			#
			# `run_with_timeout` knows whether it stopped the command and now says so directly, so
			# there is no status left to misread. A child's own 124 falls through to the arms below
			# and blocks, which is what an unexplained non-zero from a lint gate should do.
			echo "⚠️  trunk check exceeded ${TRUNK_TIMEOUT_SECONDS}s — not blocking on a timeout"
		elif [[ ${RWT_NO_CHANNEL:-0} -eq 1 && (${_trunk_rc} -eq 124 || ${_trunk_rc} -ge 128) ]]; then
			# THE DEADLINE STILL KILLS WITHOUT A CHANNEL; it just cannot be RECORDED, so this status is
			# genuinely unattributable rather than merely unrecognised. Reporting it as an external
			# signal — which is what happened before `run_with_timeout` published this — names a cause
			# the hook has no evidence for, and sends the developer looking for an OOM killer that was
			# never involved (COREDEV-2806). It blocks, because the gate did not complete.
			echo "❌ trunk did not finish, and no writable directory was found to record whether the"
			echo "   ${TRUNK_TIMEOUT_SECONDS}s deadline was reached — point TMPDIR at a writable directory"
			overall=1
		elif [[ ${_trunk_rc} -eq 2 ]]; then
			# TRUNK COULD NOT RUN, WHICH IS NOT THE SAME AS FINDING SOMETHING. Exit 2 is what the
			# real binary returns when the invocation itself is unusable — measured on trunk 1.25.0
			# with a `--filter` naming a linter this config does not enable, and reported for a
			# branch with no detectable upstream. Both reach this gate through the one `--filter`
			# literal it passes. Reported as "new findings in the staged diff" it is a false
			# statement about the developer's diff that no amount of fixing the diff will clear, so
			# it still blocks — a gate that did not run must not report a pass — but it says why.
			echo "❌ trunk could not run (exit 2) — see its message above; this is NOT a lint finding"
			overall=1
		elif [[ ${_trunk_rc} -ge 128 ]]; then
			# KILLED BY A SIGNAL, which is not a finding either. 128+N is the shell's encoding for a
			# signal death: the OOM killer, an external `kill`, a crash. `run_with_timeout` has
			# already converted the deadline cases to 124, so anything still carrying a signal status
			# here died for a reason this hook did not cause and cannot describe. It blocks — the
			# gate did not complete — but it does not blame the diff.
			echo "❌ trunk was killed (signal $((_trunk_rc - 128))) before it finished — not a lint finding"
			overall=1
		else
			echo "❌ trunk: new findings in the staged diff (fix them, or stage less)"
			overall=1
		fi
	fi
fi

# COREDEV-2801 §3b — the drift detector's second surface, for the case where hooks are disabled in the
# session but not in git. ADVISORY AND NON-BLOCKING: it never contributes to `overall`, because a stale
# install is a thing to know about, not a reason to refuse a commit. Silent on every Table A row but
# one, so an equal or locally-newer install cannot train anyone to ignore it.
#
# THE ROOT IS PASSED EXPLICITLY, derived here rather than inherited: git runs this hook from the
# worktree, so `--show-toplevel` is correct — while CLAUDE_PROJECT_DIR may be unset, empty, or left
# over from a DIFFERENT project, which would compare against a foreign manifest.
if [[ -x "${SCRIPT_DIR}/detect-plugin-version-drift.sh" ]]; then
	bash "${SCRIPT_DIR}/detect-plugin-version-drift.sh" "$(git rev-parse --show-toplevel)" || true
fi

# THE EXIT CODE AGGREGATES. Appending any passing command after the checks above would otherwise mask
# a nonzero result from them — a hook that swallows a prior failure is worse than no hook.
exit "${overall}"
